<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeyondHana.Views.TitlePage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="TitlePage">
    <FlexLayout Margin="0" Padding="0" JustifyContent="Center">
        <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*,*">
            <Image Source="flowerfield.png" Aspect="AspectFill" Grid.RowSpan="3" Grid.ColumnSpan="4"/>
            <ImageButton Source="start_button.png" x:Name="start_imagebutton" Grid.Row="1" Grid.Column="1" Clicked="StartButton_Clicked"/>
        </Grid>
    </FlexLayout>
</ContentPage>